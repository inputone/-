<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.huanghaha.treehole.mapper.PostMapper">

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO post(user_id, content)
        VALUES(#{userId}, #{content})
    </insert>

    <select id="findAll" resultType="com.huanghaha.treehole.entity.Post">
        SELECT * FROM post ORDER BY create_time DESC
    </select>

    <select id="findById" resultType="com.huanghaha.treehole.entity.Post">
        SELECT * FROM post WHERE id = #{id}
    </select>

    <delete id="deleteById">
        DELETE FROM post WHERE id = #{id}
    </delete>

</mapper>